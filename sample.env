# auca_mic_frontend environment (Vite — COMPILE-TIME values).
#
# Local dev: copy to `.env` and run `npm run dev`.
# Production: baked into the static build at build time (--build-arg / CI env).
# The running static site does NOT read env at runtime — rebuild to change it.

# Base URL of the backend API (no trailing slash).
#   dev:  http://localhost:8000
#   prod: https://micauca-api.vassilyv.me
VITE_API_BASE_URL=http://localhost:8000

# The `domain` sent to django-moses. Must match the backend's DOMAIN env var
# (written into the Site table by experiments.0002_set_site_domain).
#   prod: micauca-api.vassilyv.me
VITE_AUTH_DOMAIN=localhost:8000
