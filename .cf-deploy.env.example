# Copy to .cf-deploy.env (git-ignored) and fill in. Used by scripts/deploy_pages.sh.
# Token: Cloudflare dashboard → My Profile → API Tokens, permission:
#        Account → Cloudflare Pages → Edit (scoped to your account).

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional overrides:
# CF_PAGES_PROJECT=auca-mic
# CF_PAGES_BRANCH=main
# CF_PAGES_OUTPUT_DIR=dist
# CF_PAGES_BUILD_CMD=npm run build
